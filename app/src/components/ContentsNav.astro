---
import Icon from '@/components/ui/Icon.astro';
import DoneMark from '@/components/ui/DoneMark.astro';
import PracticedMark from '@/components/ui/PracticedMark.astro';
import type { NavSection } from '@/lib/nav';

interface Props {
  sections: readonly NavSection[];
  currentPath: string;
  label: string;
}
const { sections, currentPath, label } = Astro.props;

// /topics/x and /topics/x/ are the same page.
const trim = (path: string) => (path.length > 1 ? path.replace(/\/$/, '') : path);
const isCurrent = (href: string) => trim(href) === trim(currentPath);
---

<nav aria-label={label} class="contents-nav">
  <a href="/" class="home" aria-current={isCurrent('/') ? 'page' : undefined}>
    <Icon name="home" size={16} />
    <span class="title">Home</span>
  </a>
  {sections.map((section) => (
    <section>
      {section.label && <p class="running-head group-label">{section.label}</p>}
      <ol>
        {section.items.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.number && <span class="num">{item.number}</span>}
              <span class="title">{item.title}</span>
              {item.done && <DoneMark />}
              {item.practiced && <PracticedMark />}
              {item.badge && (
                <span class="badge">
                  <span aria-hidden="true">{item.badge.count}</span>
                  <span class="sr-only">{item.badge.label}</span>
                </span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</nav>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .home {
    align-items: center;
    margin-block-end: 0.5rem;
  }
  .group-label {
    margin: 1.25rem 0.5rem 0.35rem;
    color: var(--ink-faint);
  }
  a {
    display: flex;
    gap: 0.6rem;
    padding: 0.35rem 0.5rem;
    min-block-size: 2rem;
    color: var(--ink-soft);
    text-decoration: none;
    border-inline-start: 2px solid transparent;
    transition: background-color var(--duration-fast) var(--ease);
  }
  a:hover {
    background: var(--accent-wash);
    color: var(--ink);
  }
  a[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
    background: var(--accent-wash);
    border-inline-start-color: var(--accent);
  }
  .title {
    flex: 1;
  }
  .num {
    flex: none;
    min-inline-size: 1.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  a[aria-current='page'] .num {
    color: inherit;
  }
  .badge {
    flex: none;
    min-inline-size: 1.5rem;
    padding: 0 0.4rem;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: var(--radius-sm);
  }
  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
