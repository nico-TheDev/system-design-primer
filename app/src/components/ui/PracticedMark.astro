---
import Icon from '@/components/ui/Icon.astro';

interface Props {
  // Visible text, for rows that have room for it. Without it the text is read by screen readers only.
  label?: string | undefined;
}
const { label } = Astro.props;
---

<span class="practiced-mark">
  <Icon name="clock" size={16} />
  <span class:list={[label ? 'label' : 'sr-only']}>{label ?? 'Practiced'}</span>
</span>

<style>
  .practiced-mark {
    display: inline-flex;
    flex: none;
    gap: 0.35rem;
    align-items: center;
    color: var(--accent);
  }
  .label {
    font-size: 0.875rem;
  }
  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
