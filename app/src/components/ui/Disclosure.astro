---
interface Props {
  summary: string;
  open?: boolean;
}
const { summary, open = false } = Astro.props;
---

<details class="disclosure" open={open}>
  <summary>{summary}</summary>
  <div class="disclosure-body">
    <slot />
  </div>
</details>

<style is:global>
  .disclosure {
    margin: 1.2em 0;
    border-block: 1px solid var(--rule);
    font-family: var(--font-hanken);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .disclosure > summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-block-size: var(--control-h);
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--ink);
  }
  .disclosure > summary::-webkit-details-marker {
    display: none;
  }
  .disclosure > summary::before {
    content: '';
    flex: none;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(-45deg);
  }
  .disclosure[open] > summary::before {
    transform: rotate(45deg);
  }
  .disclosure > summary:hover {
    color: var(--accent);
  }
  .disclosure-body {
    padding-block: 0.25rem 0.9rem;
    padding-inline-start: 1.1rem;
  }
</style>
