---
interface Props {
  id: string;
  label: string;
  checked?: boolean;
  name?: string;
}
const { id, label, checked = false, name } = Astro.props;
---

<span class="checkbox">
  <label for={id}>
    <input type="checkbox" id={id} name={name} checked={checked} />
    <span>{label}</span>
  </label>
</span>

<style>
  .checkbox label {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-block-size: var(--control-h);
    padding-inline-end: 0.75rem;
    font-family: var(--font-hanken);
    font-size: 0.9375rem;
    line-height: 1.4;
    cursor: pointer;
  }
  /* The input is the 24px box inside a 40px hit area; the label wraps both. */
  input {
    box-sizing: content-box;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    margin: 0;
    padding: 0.5rem;
    accent-color: var(--accent);
    cursor: pointer;
  }
</style>
