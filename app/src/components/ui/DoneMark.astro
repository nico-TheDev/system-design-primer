---
import Icon from '@/components/ui/Icon.astro';
---

<span class="done-mark">
  <Icon name="check" size={16} />
  <span class="sr-only">Done</span>
</span>

<style>
  .done-mark {
    display: inline-flex;
    flex: none;
    color: var(--done);
  }
  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
