---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

{/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex -- a scroll region must be keyboard reachable (WCAG 2.1.1) */}
<div class="table-wrap" role="region" tabindex="0" aria-label={label}>
  <slot />
</div>
