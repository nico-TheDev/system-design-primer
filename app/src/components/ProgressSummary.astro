---
import type { Count } from '@/lib/progress';

interface Props {
  topics: Count;
  exercises: Count;
  practiced?: Count;
}
const { topics, exercises, practiced = { done: 0, total: 0 } } = Astro.props;
const lines = [
  { id: 'topics', text: `${topics.done} of ${topics.total} topics done`, count: topics },
  {
    id: 'exercises',
    text: `${exercises.done} of ${exercises.total} exercises done`,
    count: exercises,
  },
  {
    id: 'practiced',
    text: `${practiced.done} of ${practiced.total} exercises practiced`,
    count: practiced,
  },
].filter((line) => line.count.total > 0);
---

{lines.length > 0 && (
  <div class="summary">
    {lines.map(({ id, text, count }) => (
      <div class="line">
        <label for={`progress-${id}`}>{text}</label>
        <progress id={`progress-${id}`} value={count.done} max={count.total}></progress>
      </div>
    ))}
  </div>
)}

<style>
  .summary {
    display: grid;
    gap: 0.75rem;
    margin-block: 1.5rem;
    font-family: var(--font-hanken);
    font-size: 0.9375rem;
  }
  .line {
    display: grid;
    gap: 0.3rem;
    max-inline-size: 24rem;
  }
  label {
    color: var(--ink-soft);
  }
  progress {
    appearance: none;
    inline-size: 100%;
    block-size: 0.625rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    overflow: hidden;
  }
  progress::-webkit-progress-bar {
    background: var(--paper-raised);
  }
  progress::-webkit-progress-value {
    background: var(--done);
  }
  progress::-moz-progress-bar {
    background: var(--done);
  }
</style>
