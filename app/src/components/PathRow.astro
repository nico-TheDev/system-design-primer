---
import DoneMark from '@/components/ui/DoneMark.astro';
import PracticedMark from '@/components/ui/PracticedMark.astro';

interface Props {
  number: number;
  title: string;
  href: string;
  done?: boolean;
  // Exercise rows only: where practice lives, whether a session is open, and finished attempts.
  practiceHref?: string | undefined;
  practicing?: boolean;
  practiced?: number;
}
const {
  number,
  title,
  href,
  done = false,
  practiceHref,
  practicing = false,
  practiced = 0,
} = Astro.props;
---

<li class="path-row">
  <a class="link main" {href}>
    <span class="num">{number}</span>
    <span class="title">{title}</span>
    {done && <DoneMark />}
    {practiced > 0 && (
      <PracticedMark label={practiced > 1 ? `Practiced ${practiced} times` : 'Practiced'} />
    )}
  </a>
  {practiceHref && (
    <a class="link practice" href={practiceHref}>
      {practicing ? 'Resume practice' : 'Practice'}
      <span class="sr-only"> {title}</span>
    </a>
  )}
</li>

<style>
  .path-row {
    display: flex;
    align-items: stretch;
    border-block-end: 1px solid var(--rule);
    font-family: var(--font-hanken);
    font-size: 1rem;
  }
  .link {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    min-block-size: var(--control-h);
    padding: 0.5rem 0.5rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease);
  }
  .link:hover {
    background: var(--accent-wash);
  }
  .main {
    flex: 1;
    min-inline-size: 0;
    flex-wrap: wrap;
  }
  .practice {
    flex: none;
    align-items: center;
    padding-inline: 0.75rem;
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .title {
    flex: 1;
  }
  .num {
    flex: none;
    min-inline-size: 2rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
