---
import Button from '@/components/ui/Button.astro';
import type { Neighbour } from '@/lib/study-path';

interface Props {
  label: string;
  prev?: Neighbour | undefined;
  next?: Neighbour | undefined;
  // Shown between the two links, for example "All exercises".
  middle?: { readonly title: string; readonly href: string } | undefined;
}
const { label, prev, next, middle } = Astro.props;

const text = (n: Neighbour) => (n.number ? `${n.number} · ${n.title}` : n.title);
---

<nav aria-label={label} class="pager">
  <div class="slot">{prev && <Button href={prev.href}>← {text(prev)}</Button>}</div>
  {middle && (
    <Button variant="ghost" href={middle.href}>
      {middle.title}
    </Button>
  )}
  <div class="slot end">{next && <Button href={next.href}>{text(next)} →</Button>}</div>
</nav>

<style>
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
  }
  .slot {
    display: flex;
    flex: 1 1 14rem;
  }
  .slot.end {
    justify-content: flex-end;
  }
  /* Titles can be long, so buttons wrap instead of overflowing at 360px. */
  .pager :global(.btn) {
    block-size: auto;
    min-block-size: var(--control-h);
    padding-block: 0.4rem;
    text-align: start;
  }
</style>
