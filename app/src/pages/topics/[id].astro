---
import { actions } from 'astro:actions';
import { getEntry } from 'astro:content';
import DoneButton from '@/components/DoneButton.astro';
import PathPager from '@/components/PathPager.astro';
import Shell from '@/layouts/Shell.astro';
import { loadStudyPath } from '@/lib/load-study-path';
import { doneDate } from '@/lib/progress';
import { headingShift, shiftHeadings, toShellHeadings } from '@/lib/study-path';

// Redirect after a saved press so a browser refresh never offers to resubmit the form.
const saved = Astro.getActionResult(actions.setProgress);
if (saved && !saved.error) return Astro.redirect(Astro.url.pathname, 303);

const { id } = Astro.params;
const { path, index } = await loadStudyPath();
const entry = path.topics.find((t) => t.id === id);
const topic = id ? (await getEntry('topics', id))?.data : undefined;
if (!entry || !topic) return Astro.rewrite('/404');

const by = headingShift(topic.kind);
---

<Shell
  title={`${topic.title} · System Design Study`}
  runningHead={`${entry.number} · ${topic.title}`}
  nav={path.nav}
  headings={toShellHeadings(topic.headings, by)}
>
  <h1>{topic.title}</h1>
  <Fragment set:html={shiftHeadings(topic.html, by)} />
  <DoneButton kind="topic" id={entry.id} completedAt={doneDate(index, 'topic', entry.id)} />
  <PathPager label="Previous and next topic" prev={entry.prev} next={entry.next} />
</Shell>
